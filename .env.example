# Auth.js (NextAuth) Ortam Değişkenleri
# NEXTAUTH_SECRET için rastgele bir değer üret: `npx auth secret` veya `openssl rand -base64 32`.
# Bu dosyadaki örnek değeri ASLA olduğu gibi kullanma.
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3005

# Sitenin herkese açık adresi (canlıda kendi alan adın / Vercel adresin, sonunda / olmadan)
NEXT_PUBLIC_SITE_URL=http://localhost:3005

# GitHub OAuth App Değişkenleri (https://github.com/settings/developers)
# Callback URL (yerel):  http://localhost:3005/api/auth/callback/github
# Callback URL (canlı):  https://SITE_ADRESIN/api/auth/callback/github
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here

# Supabase Veritabanı Bağlantı Bilgileri (https://supabase.com)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
# Gizli: yalnızca sunucuda kullanılır. Asla NEXT_PUBLIC_ ile başlatma, repoya koyma.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Opsiyonel: GitHub API limitini 60/saat -> 5000/saat çıkarır (github.com/settings/tokens, izin gerekmez)
GITHUB_TOKEN=
